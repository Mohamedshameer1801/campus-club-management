# Copy to .env and adjust. NEVER commit a real .env file.

# --- SQLite (core application data) ---
# Path of the SQLite database file (created + migrated automatically on first start).
DATABASE_PATH=./data/campus.db

# --- Sessions / security ---
# Set to "false" ONLY when serving the production build over plain http (e.g. http://localhost).
COOKIE_SECURE=true
# Extra trusted origins for the CSRF origin check (comma separated). Same-origin requests are always allowed.
TRUSTED_ORIGINS=
# bcrypt cost factor (10-12 recommended).
BCRYPT_ROUNDS=10
# Public base URL, used inside certificate QR codes (falls back to the request origin).
APP_URL=http://localhost:3000

# --- Google Sign-In (students) ---
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials and add your origin
# to "Authorized JavaScript origins". Both values are the SAME client id (no secret is needed for ID tokens).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: restrict Google sign-in to one hosted domain (e.g. college.edu)
GOOGLE_ALLOWED_DOMAIN=

# --- Demo data (local demos only) ---
# Seeds clearly-flagged demo accounts/data when the database is empty.
AUTO_SEED_DEMO=true
# Shows the demo credential helper on the login page.
NEXT_PUBLIC_DEMO_MODE=true
# Password used for every seeded demo account.
DEMO_PASSWORD=Password123!

# --- Optional AI-assisted portfolio text (OpenAI-compatible chat completions API) ---
# Leave empty to use the deterministic, template-based generator (clearly labelled in the UI).
AI_API_URL=
AI_API_KEY=
AI_MODEL=
